#!/usr/bin/env node
// A launcher, not the CLI: bin/familiar.js is the CLI. It statically imports
// modules that resolve bare specifiers, so with node_modules absent it dies at
// resolution time with a raw ERR_MODULE_NOT_FOUND that names neither familiar nor
// the fix -- once per hook, for every hook. Check first, then load the CLI.
import { requireDependencies } from '../src/deps.js';

requireDependencies();
const { run } = await import('./familiar.js');
await run();
