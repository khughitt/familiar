#!/usr/bin/env node
// The Niri integration's composition root. `watch` is the one long-running desktop
// coordinator (window map and material signals, workspace feed, attention attribution,
// toasts, heartbeat); `sync` is one pass of the same work. Every default dependency is
// bound here; the integration modules take them as arguments.
import { execFile, spawn } from 'node:child_process';
import { promisify } from 'node:util';
import { watch } from 'node:fs';
import { createInterface } from 'node:readline';
import { createProcessOps } from 'relay';
import { paths as resolvePaths } from '../src/bus/paths.js';
import { readJson, writeJsonAtomic } from '../src/bus/store.js';
import { readSessions } from '../src/bus/sessions.js';
import { loadConfig } from '../src/config.js';
import { loadContext } from '../src/observe/context.js';
import { currentEpoch } from '../src/attention/store.js';
import { mapSessionsToWindows, niriWindowsPath } from '../integrations/niri/window.js';
import { niriHasSignals, planWindowSignals } from '../integrations/niri/signal.js';
import { runCoordinator, syncOnce } from '../integrations/niri/coordinator.js';

const exec = promisify(execFile);
const [command, ...rest] = process.argv.slice(2);
const usage = () => {
  process.stderr.write('usage: familiar-niri <sync | watch>\n');
  process.exit(1);
};
if (rest.length > 0 || !['sync', 'watch'].includes(command)) usage();

const paths = resolvePaths();
const windowsPath = niriWindowsPath(paths);   // derived HERE — src/ may not name niri
const processOps = createProcessOps();

let lastWritten = null;
// What this process last told niri, per window and per session. See planWindowSignals.
let sent = new Map();
let states = new Map();
let signalsUnsupportedSaid = false;

// The session → window map and niri's material signals, from one windows query.
async function syncWindows(windows) {
  const { sessions } = await readSessions(paths.sessionsPath);
  const map = mapSessionsToWindows(sessions, windows);

  // WindowFocusChanged fires on every focus change — constantly. Writing an
  // identical map each time would wake workspace-awareness readers for nothing. Compare
  // before writing.
  const serialized = JSON.stringify(map);
  if (serialized !== lastWritten) {
    lastWritten = serialized;
    await writeJsonAtomic(windowsPath, map);
  }

  // The same join feeds niri's material signals: each window hosting a session
  // carries one `familiar` slot, lit in that session's identity hue.
  if (!niriHasSignals(windows)) {
    if (!signalsUnsupportedSaid) {
      signalsUnsupportedSaid = true;
      process.stderr.write('this niri has no window signals; windows get no familiar hue\n');
    }
    return;
  }
  const intent = (await readJson(paths.intentPath)) ?? {};
  const { themeId } = await loadConfig({ paths });
  const plan = planWindowSignals({
    intent, sessions, sessionWindows: map, windows, sent, states, themeId, now: Date.now(),
  });
  sent = plan.sent;
  states = plan.states;
  for (const { windowId, args } of plan.commands) {
    try {
      await exec('niri', ['msg', ...args]);
    } catch (error) {
      // One window refusing must not starve the others. Forget what was "sent" to
      // it, so the next resync tries again rather than trusting a write that failed.
      sent.delete(windowId);
      process.stderr.write(`niri msg ${args[0]} --id ${windowId}: ${error.stderr?.trim() || error.message}\n`);
    }
  }
}

const clock = {
  now: () => Date.now(),
  setTimeout: (fn, ms) => setTimeout(fn, ms),
  clearTimeout: (id) => clearTimeout(id),
  setInterval: (fn, ms) => setInterval(fn, ms),
  clearInterval: (id) => clearInterval(id),
};

// Niri's event stream as lines; closing it reaps the child. `ended` says how the child
// ended, from its `close` event, which comes after the lines end; a spawn error is an
// end with neither an exit code nor a signal.
function eventStream() {
  const child = spawn('niri', ['msg', '-j', 'event-stream'], { stdio: ['ignore', 'pipe', 'inherit'] });
  const ended = new Promise((resolve) => {
    child.on('error', (error) => {
      process.stderr.write(`niri event stream: ${error.message}\n`);
      resolve({ code: null, signal: null });
    });
    child.on('close', (code, signal) => resolve({ code, signal }));
  });
  return {
    lines: createInterface({ input: child.stdout }),
    close: () => child.kill('SIGTERM'),
    ended,
  };
}

const deps = {
  paths, relay: processOps, execFile: exec, clock, stderr: process.stderr,
  loadContext: () => loadContext({ paths }), liveEpoch: () => currentEpoch({ processOps }),
};

if (command === 'sync') {
  const { stdout } = await exec('niri', ['msg', '-j', 'windows']);
  await syncWindows(JSON.parse(stdout));
  process.exitCode = await syncOnce(deps);
} else {
  // WATCH THE DIRECTORY, NOT THE FILE. writeJsonAtomic replaces sessions.json via
  // rename(2), which swaps the INODE — and inotify watches the inode, not the
  // path. A watch on the file itself delivers events for the first atomic write
  // and then goes permanently deaf. The coordinator watches the state directory.
  const handle = processOps.handleOf(process.pid);
  const code = await runCoordinator({
    ...deps, watch, signals: process, eventStream, syncWindows,
    owner: { pid: process.pid, start: handle.start },
  });
  process.exit(code);   // nonzero lets the supervisor restart us
}
